{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: main_ai.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_ai.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Python: main_ai.py (no display)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_ai.py",
            "args": ["--no-display"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
